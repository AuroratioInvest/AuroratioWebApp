# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./auroratio.db

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Public accountless signal subscription; startup mirrors this into the local
# monthly subscription plan row when the configured plan code is missing.
STRIPE_MONTHLY_SIGNAL_PRICE_ID=price_...
MONTHLY_SIGNAL_PLAN_CODE=monthly-signals
# Optional existing Stripe Billing Portal configuration
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Trusted browser origin used to build Checkout, cancellation, and Portal return URLs.
# HTTPS is required outside localhost.
PUBLIC_APP_URL=http://localhost:5173

# Short-lived, single-use accountless Portal links
PORTAL_ACCESS_TOKEN_TTL_MINUTES=15
# Cross-instance issuance cooldown per Stripe Customer relationship
PORTAL_LINK_COOLDOWN_MINUTES=5
# Minimum generic portal-request response time to reduce email-enumeration signals
PORTAL_REQUEST_MIN_RESPONSE_MS=750

# ===== Brevo =====
# Brevo transactional email delivery
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@auroratio.com
BREVO_SENDER_NAME=AuroRatio

# ===== Telegram =====
# Private-channel fulfillment after webhook-confirmed access
TELEGRAM_BOT_TOKEN=
# Trusted private subscriber channel. Startup creates the local channel row and
# monthly-plan mapping when they are missing; it never creates a Telegram channel.
TELEGRAM_CHANNEL_ID=-100...
TELEGRAM_CHANNEL_CODE=private-signals
TELEGRAM_CHANNEL_DISPLAY_NAME_EN=AuroRatio Private Signals
TELEGRAM_CHANNEL_DISPLAY_NAME_FR=Signaux privés AuroRatio
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_INVITE_TTL_HOURS=24
TELEGRAM_PROVIDER_TIMEOUT_SECONDS=10
ACCESS_FULFILLMENT_MAX_ATTEMPTS=5
ACCESS_FULFILLMENT_RETRY_SECONDS=300
ACCESS_FULFILLMENT_CLAIM_LEASE_SECONDS=900

# Admin-approved subscriber signal publication to private channels
SIGNAL_PUBLICATION_MAX_ATTEMPTS=5
SIGNAL_PUBLICATION_RETRY_SECONDS=300
SIGNAL_PUBLICATION_CLAIM_LEASE_SECONDS=900

# Trusted automatic strategy-to-subscriber-signal bridge
# Defaults to MONTHLY_SIGNAL_PLAN_CODE when unset. Use a comma-separated list
# only for configured active launch plans that should receive automatic signals.
SUBSCRIBER_SIGNAL_PLAN_CODES=monthly-signals
# Maximum tolerated age for normalized market observations used by the root
# precious-metals strategy. The current development adapter preserves the
# existing Yahoo Finance retrieval path behind a provider-neutral boundary.
MARKET_DATA_MAX_AGE_DAYS=4
# Local SQLite development only: when the snapshot table is empty or has not
# been migrated yet, read validated rows from the repository root /data CSV.
# PostgreSQL never uses this fallback, even if this flag is enabled.
MARKET_DATA_LOCAL_FILE_FALLBACK=true
